# Dirección de la web (local: http://localhost:3000 · producción: https://tu-dominio)
APP_URL=http://localhost:3000

# Misma clave que HARDWARE_API_KEY en .env.local de la web. Genera una nueva con:
#   python -c "import secrets; print(secrets.token_hex(24))"
HARDWARE_API_KEY=

# Segundos en los que se ignora el mismo QR después de leerlo
COOLDOWN_SECONDS=10
REQUEST_TIMEOUT=6

# Arduino: auto (lo busca solo), none (sin pluma) o el puerto, por ejemplo COM3
SERIAL_PORT=auto
BAUDRATE=9600

# Lectura de placa con la segunda cámara: off | on (requiere requirements-ocr.txt)
PLATE_CHECK=off
PLATE_TIMEOUT=4
PLATE_VOTES=2

# Cámaras del proyecto: OV9732 (720p, gran angular) para el QR
# y OV2720 (1080p 30 FPS) para la placa, que necesita más detalle.
QR_CAMERA_RES=1280x720
PLATE_CAMERA_RES=1920x1080

MAX_CAMERAS_TO_SCAN=6
SHOW_WINDOW=true
