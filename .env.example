# ── Supabase (obligatorio) ──
NEXT_PUBLIC_SUPABASE_URL=https://occfdpeosckzsvcdvfvf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BDQxQ10AUmkzZna2ZdxJnQ_uwbbUxaJ
SUPABASE_SERVICE_ROLE_KEY=

# ── Seguridad ──
# Secreto de al menos 32 caracteres para firmar sesiones (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Clave compartida con el escáner de la caseta (cabecera x-api-key)
HARDWARE_API_KEY=
# Administrador de pruebas para entrar a /admin (déjalo vacío en producción)
ADMIN_USER=
ADMIN_PASSWORD=
# Muestra «Simular lectura de QR» en /admin (registra accesos reales). Solo "true" lo activa.
ENABLE_SCAN_SIMULATOR=false

# ── Institución y sitio ──
NEXT_PUBLIC_INSTITUTION_DOMAIN=itsatlixco.edu.mx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Escáner de caseta ──
# Verificación de la placa leída por OCR contra la del QR: off (ignora) | warn (registra y avisa en consola) | strict (rechaza con 403 y no registra)
PLATE_CHECK=off
# Segundos mínimos entre dos accesos de la misma placa; una lectura antes responde 409 DUPLICADO sin registrar (default 15)
SCAN_MIN_INTERVAL_SECONDS=15
